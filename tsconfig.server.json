{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "allowJs": true,
    "strict": false,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": false,
    "rootDir": ".",
    "outDir": "dist",
    "downlevelIteration": true,
    "lib": ["ES2022", "DOM"]
  },
  "include": ["server/**/*.ts"],
  "exclude": ["node_modules", "dist", "client", "server/generated"]
}
