  "scripts": {
    "dev": "cross-env NODE_ENV=development tsx watch server/index.ts",
    "dev:client": "vite",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint . --ext ts,tsx --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md}\"",
    "type-check": "tsc --noEmit",
    "preview": "vite preview",
    "build": "npm run type-check && npm run build:client && npm run build:server",
    "build:client": "vite build",
    "build:server": "npx tsc -p tsconfig.server.json",
    "start": "node dist/index.js",
    "dev:pm2": "pm2 start ecosystem.config.mjs",
    "dev:pm2:stop": "pm2 stop trading-server-dev",
    "dev:pm2:restart": "pm2 restart trading-server-dev",
    "dev:pm2:delete": "pm2 delete trading-server-dev",
    "dev:pm2:logs": "pm2 logs trading-server-dev",
    "server:pm2:start": "pm2 start ecosystem.config.server.mjs",
    "server:pm2:stop": "pm2 stop trading-server",
    "server:pm2:restart": "pm2 restart trading-server",
    "server:pm2:delete": "pm2 delete trading-server",
    "server:pm2:logs": "pm2 logs trading-server",
    "pm2:status": "pm2 status",
    "check": "npm run type-check && npm run lint && npm run format:check"
  },
